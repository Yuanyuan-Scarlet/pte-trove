{
  "name": "xiaoyuan-pte-trove",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "browserslist": [
    "chrome 92",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "archive": "tsx scripts/archive-files.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:all": "npm run build && npm test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "marketing:images": "node scripts/generate-marketing-images.mjs",
    "marketing:square-cards": "node scripts/generate-square-material-cards.mjs",
    "marketing:pte-cards": "node scripts/generate-pte-question-cards.mjs",
    "db:generate": "drizzle-kit generate",
    "admin:hash": "node scripts/hash-admin-password.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.2.8",
    "@pdf-lib/fontkit": "1.1.1",
    "better-sqlite3": "13.0.2",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.2",
    "lucide-react": "0.468.0",
    "next": "^16.2.12",
    "pdf-lib": "1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
