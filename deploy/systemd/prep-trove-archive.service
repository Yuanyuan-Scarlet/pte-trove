[Unit]
Description=Archive expired Xiaoyuan PTE Trove files
After=prep-trove.service

[Service]
Type=oneshot
User=prep-trove
Group=prep-trove
WorkingDirectory=/opt/prep-trove/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/prep-trove.env
ExecStart=/usr/bin/npm run archive
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prep-trove
UMask=0027
