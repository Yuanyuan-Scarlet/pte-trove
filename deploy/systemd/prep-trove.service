[Unit]
Description=Xiaoyuan PTE Trove web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prep-trove
Group=prep-trove
WorkingDirectory=/opt/prep-trove/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3100
EnvironmentFile=/etc/prep-trove.env
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prep-trove
UMask=0027

[Install]
WantedBy=multi-user.target
